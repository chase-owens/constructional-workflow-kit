{
  "name": "chase-ai-workflow-starter",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "domain",
    "lambdas",
    "infra"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "check": "nx run-many -t check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "synth": "npm run synth --workspace=@chase-ai-workflow/infra",
    "validate": "npm run format:check && npm run lint && npm run check && npm run synth"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "nx": "^23.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.66.0"
  },
  "allowScripts": {
    "nx@23.1.1": true,
    "esbuild@0.25.12": true
  }
}
